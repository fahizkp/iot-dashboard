# MongoDB Connection (external service)
MONGODB_URI=mongodb://user:password@host:27017/sample?authSource=admin

# JWT Secret (generate a random 256-bit secret)
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here

# JWT Token Expiry (optional, defaults to 8h)
JWT_EXPIRES_IN=8h

# Admin Credentials
# Password should be bcrypt hashed. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2a$10$hashedpasswordhere

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Origin (for development)
CORS_ORIGIN=http://localhost:5173
